<Application x:Class="MillionHoursTimer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>

        <Style TargetType="Window" x:Key="BaseWindow">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FAFAFA" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,2,0,10" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>
    </Application.Resources>
</Application>
