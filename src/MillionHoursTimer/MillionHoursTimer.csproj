<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイのアイコンと、exe からのアイコン取得に使う -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <StartupObject>MillionHoursTimer.Program</StartupObject>
    <Version>2.0.0</Version>
    <Product>MillionHoursTimer</Product>
    <Company>kanchi0914</Company>
    <Copyright>Copyright (c) kanchi0914</Copyright>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF と WinForms の型名がぶつかるので、WinForms は明示的に名前空間を書いて使う -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Main を自分で書くため (Velopack の初期化と二重起動の防止) -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\defaultIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MillionHoursTimer.Core\MillionHoursTimer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
