<Window x:Class="MillionHoursTimer.UI.FileListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="440" MinWidth="460" MinHeight="220"
        Style="{StaticResource BaseWindow}" Icon="/Resources/app.ico" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="閉じる" DockPanel.Dock="Right" IsCancel="True" Click="OnClose" />
            <Button Content="全て削除..." DockPanel.Dock="Left" Click="OnDeleteAll" />
            <Button Content="自動削除の設定..." DockPanel.Dock="Left" Margin="8,0,0,0" Click="OnCleanupSettings" />
            <TextBlock x:Name="CleanupStatus" Margin="10,0" VerticalAlignment="Center" Foreground="#666" FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="Collapsed"
                   Text="まだファイル別の記録はありません。メイン画面の右クリック →「ファイル拡張子を設定」で拡張子を設定すると、タイトルバーに表示されるファイル名ごとに記録できます。" />
        <ListView x:Name="FileList" SelectionMode="Extended" ContextMenuOpening="OnContextMenuOpening">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="Background" Value="#FFE1E8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MergeMenu" Header="選択した項目をまとめる..." Click="OnMerge" />
                    <MenuItem Header="表示内容をコピー" Click="OnCopy" />
                    <Separator />
                    <MenuItem x:Name="LockMenu" Header="ロックする" Click="OnToggleLock" />
                    <Separator />
                    <MenuItem Header="一覧から削除..." Click="OnDelete" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ロック" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="LockIcon" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" Foreground="#666" Visibility="Hidden"
                                           ToolTip="ロック中 (自動削除・全て削除の対象にしません)" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="ファイル名" Width="260" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="累積作業時間" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" FontFamily="BIZ UDGothic, MS Gothic" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="最終作業日" Width="100" DisplayMemberBinding="{Binding LastDayText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
