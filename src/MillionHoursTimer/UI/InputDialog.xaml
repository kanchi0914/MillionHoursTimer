<Window x:Class="MillionHoursTimer.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=Input}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Padding="4,3" />
        <TextBlock x:Name="Hint" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
            <Button Content="キャンセル" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
