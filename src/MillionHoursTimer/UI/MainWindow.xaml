<Window x:Class="MillionHoursTimer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MillionHoursTimer" Width="660" Height="480" MinWidth="440" MinHeight="260"
        Style="{StaticResource BaseWindow}" Icon="/Resources/app.ico"
        ShowInTaskbar="False" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2" Background="#F0F0F0">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="アプリを追加(_A)..." Click="OnAddApp" />
                <Separator />
                <MenuItem Header="データフォルダを開く(_O)" Click="OnOpenDataFolder" />
                <MenuItem Header="データをバックアップ(_B)..." Click="OnBackup" />
                <MenuItem Header="旧バージョンのデータを取り込む(_I)..." Click="OnImportLegacy" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="履歴とグラフ(_H)..." Click="OnHistory" />
            </MenuItem>
            <MenuItem Header="設定(_S)" Click="OnSettings" />
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="使い方 (GitHub)" Click="OnHelp" />
                <MenuItem Header="更新を確認(_U)" Click="OnCheckUpdate" />
                <MenuItem Header="バージョン情報(_A)" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Background="#F3F3F3" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="UpdateNotice" DockPanel.Dock="Right" Visibility="Collapsed" Margin="12,0,0,0">
                    <Hyperlink Click="OnInstallUpdate"><Run x:Name="UpdateNoticeText" /></Hyperlink>
                </TextBlock>
                <TextBlock x:Name="StatusText" Foreground="#555" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Margin="12,10,12,10">
            <ListView x:Name="AppList" SelectionMode="Extended" MouseDoubleClick="OnRowDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="2,3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Background" Value="#FFE1E8" />
                                <Setter Property="ToolTip" Value="記録中" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="表示名を変更..." Click="OnRename" />
                        <MenuItem Header="ファイル別の作業時間..." Click="OnShowFiles" />
                        <MenuItem Header="ファイル拡張子を設定..." Click="OnSetExtensions" />
                        <Separator />
                        <MenuItem Header="表示内容をコピー" Click="OnCopy" />
                        <Separator />
                        <MenuItem Header="一覧から削除..." Click="OnRemove" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="アプリケーション名" Width="270">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="今日の起動時間" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TodayText}" HorizontalAlignment="Right" FontFamily="BIZ UDGothic, MS Gothic" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="累積起動時間" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" FontFamily="BIZ UDGothic, MS Gothic" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="#888" LineHeight="22">
                記録したいアプリの実行ファイル (.exe) かショートカットを<LineBreak />
                ここにドラッグ＆ドロップしてください<LineBreak />
                (メニューの「ファイル → アプリを追加」からも登録できます)
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
